# MODERNIZED-2026  see MODERNIZATION.md
# $Id: Makefile.in 647 2003-10-25 23:34:13Z weasel $

# Edit according to the libraries you want to use:
INC = %INC
DEF = %DEF -DUSE_SOCK %MIXDIR
LIBS = %LIBS
LDFLAGS = %LDFLAGS

# -Wno-pointer-sign / -Wno-deprecated-declarations: the vintage tree mixes byte*
# (unsigned char*) with char* throughout, and uses OpenSSL's low-level DES/RSA
# API that OpenSSL 3 deprecates wholesale. Both are inherent to the 2008 code and
# produced ~250 warnings that buried the handful worth reading.
WARN = -Wall -Wno-pointer-sign -Wno-deprecated-declarations
OPT = -g $(WARN)
# OPT = -g -pg $(WARN) -DDEBUG
# OPT = -O2 $(WARN)

CFLAGS = $(INC) $(DEF) $(OPT)
CC = gcc
AR = ar rc
RANLIB = ranlib
#MAKE = make

OBJ = mix.o rem.o rem1.o rem2.o chain.o chain1.o chain2.o nym.o pgp.o pgpdb.o pgpdata.o pgpget.o pgpcreat.o pool.o mail.o rfc822.o mime.o keymgt.o compress.o stats.o crypto.o random.o util.o buffers.o maildir.o parsedate.tab.o

REM_OBJ = remailer/remailer_dispatch.o remailer/remailer_admin.o remailer/remailer_server.o

MIXOBJ = rndseed.o menu.o menusend.o menunym.o menuutil.o menustats.o
NOMENUOBJ = rndseed.o dummy.o
WINOBJ = winmain.o winutil.o

all:	mixmaster mixremailer

mixmaster: $(OBJ) $(MIXOBJ) main.o $(REM_OBJ) $(LIBS)
	$(CC) $(OBJ) $(MIXOBJ) main.o $(REM_OBJ) $(LIBS) $(LDFLAGS) -o mixmaster

mixremailer: $(OBJ) $(NOMENUOBJ) remailer/mixremailer.o $(REM_OBJ) $(LIBS)
	$(CC) $(OBJ) $(NOMENUOBJ) remailer/mixremailer.o $(REM_OBJ) $(LIBS) $(LDFLAGS) -o mixremailer

libmix.a: $(OBJ) $(MIXOBJ) dllmain.o
	$(AR) libmix.a $(OBJ) $(MIXOBJ) dllmain.o

libmix32.a: libmix.a mixlib.def
	dllwrap --dllname mixlib.dll --def mixlib.def --output-lib libmix32.a libmix.a zlib-1.1.4/libz.a pcre-2.08/libpcre.a openssl/libeay32.a -lwsock32

dllmix: main.o libmix32.a
	$(CC) main.o libmix32.a -o dllmix

winmix.exe:	$(WINOBJ) libmix32.a
	$(CC) $(WINOBJ) libmix32.a -lgdi32 -luser32 $(LDFLAGS) -o mixmaster.exe

winmix: winmenu.res #winmix.exe
	rsrc winmenu.res mixmaster.exe

winmenu.o:	winmenu.rc winmenu.h
	windres winmenu.rc winmenu.o

# Vintage standalone remailer binary from remailer.c, superseded by mixremailer.
# Renamed from `remailer`: the 2026 refactor added the Src/remailer/ directory, so
# make saw that directory as the target and reported "up to date" without ever
# linking anything.
remailer-legacy:	$(OBJ) $(NOMENUOBJ) remailer.o $(REM_OBJ) $(LIBS)
	$(CC) $(OBJ) $(NOMENUOBJ) remailer.o $(REM_OBJ) $(LIBS) $(LDFLAGS) -o remailer-legacy

mpgp:	$(OBJ) $(NOMENUOBJ) mpgp.o $(REM_OBJ) $(LIBS)
	$(CC) $(OBJ) $(NOMENUOBJ) mpgp.o $(REM_OBJ) $(LIBS) $(LDFLAGS) -o mpgp

# Tests link the real objects, so they exercise production code rather than a
# copy of it. NEW-2026 -- see FIXPLAN.md (F12).
TESTS = tests/test-parse_yearmonthday tests/test-crypto-keys
TESTOBJ = $(OBJ) $(NOMENUOBJ) $(REM_OBJ)

tests/test-parse_yearmonthday: tests/test-parse_yearmonthday.o $(TESTOBJ) $(LIBS)
	$(CC) tests/test-parse_yearmonthday.o $(TESTOBJ) $(LIBS) $(LDFLAGS) -o $@

tests/test-crypto-keys: tests/test-crypto-keys.o $(TESTOBJ) $(LIBS)
	$(CC) tests/test-crypto-keys.o $(TESTOBJ) $(LIBS) $(LDFLAGS) -o $@

tests:	$(TESTS)

check:	$(TESTS)
	@fail=0; for t in $(TESTS); do \
	  echo "=== $$t ==="; ./$$t || fail=1; \
	done; \
	if [ $$fail -ne 0 ]; then echo "FAILED"; exit 1; fi; \
	echo "All tests passed."

.PHONY: all tests check clean allclean distclean ci

clean:
	-rm -f *.o remailer/*.o tests/*.o *.a *.res *~ mixmaster mixremailer remailer-legacy mix *.exe mpgp core gmon.out $(TESTS)

allclean: clean
	-rm -f Makefile

distclean:	allclean

ci: clean
	cd ~/src/mix3; ci -l * Mix/* Mix/Src/*; echo

parsedate.tab.c: parsedate.y
	@echo Expect 6 shift/reduce conflicts
	bison parsedate.y

parsedate: parsedate.tab.c
	gcc -DTEST parsedate.tab.c -o parsedate


include Makefile.deps
